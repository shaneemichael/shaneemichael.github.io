</style>

<script>
  import "../scripts/scroll";
  import "../scripts/hover-sound";
  import { runBrushIntro } from "../scripts/brush-intro";
  import { initFilings } from "../scripts/filings";
  import { initDemoVideos } from "../scripts/demo-video";

  initDemoVideos();

  const filings = document.querySelector<HTMLCanvasElement>("[data-filings]");
  if (filings) initFilings(filings);


  document.querySelectorAll<HTMLButtonElement>("[data-more-toggle]").forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute("aria-controls")!)!;
    const inner = panel.firstElementChild as HTMLElement;
    const label = btn.querySelector("[data-more-label]")!;
    const count = btn.dataset.moreCount;
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      panel.dataset.open = String(open);
      inner.inert = !open;
      label.textContent = open ? "Show less" : `${btn.dataset.moreText ?? "Read more"} (${count})`;
    };
    set(false);
    btn.hidden = false;
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
  });

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const heroReady = hero
    ? import("../scripts/hero")
        .then((m) => m.initHero(hero))
        .then((ok) => {
          if (!ok) return;
          hero.dataset.canvas = "on";
          hero.querySelector<HTMLElement>("[data-hero-hold]")?.removeAttribute("hidden");
        })
        .catch(() => {})
    : Promise.resolve();

  // Brush the page into colour once the hero is actually drawn (capped so a slow load never holds it grey).
  Promise.race([heroReady, new Promise((r) => setTimeout(r, 2000))]).then(() =>
    requestAnimationFrame(() => requestAnimationFrame(() => runBrushIntro())),
  );
</script>
